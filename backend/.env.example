# Backend Environment Configuration
# CRITICAL: Copy this file to .env and fill in your values
# NEVER commit the actual .env file!
#
# Production runs on Dokploy (Docker). Set these variables in the backend
# application's "Environment" tab.
#   Frontend:  https://forge.kesslermatics.com
#   Backend:   https://forge.kesslermatics.com/api   (Traefik strips /api)
#   MCP:       https://forge.kesslermatics.com/mcp

# Database Configuration
# On Dokploy use the INTERNAL connection string of the Postgres service
# (host = the service's app name, port 5432).
DATABASE_URL=postgresql://username:password@localhost:5432/hevycoach

# JWT Secret Key - Generate a strong random key for production!
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT Algorithm
JWT_ALGORITHM=HS256

# Token expiration time in minutes (7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Encryption key for API credentials (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: when migrating an existing database this MUST be the same key as before,
# otherwise stored Hevy/Yazio/Google credentials can no longer be decrypted.
ENCRYPTION_KEY=your-fernet-key-here

# Yazio API Credentials (for nutrition tracking)
YAZIO_EMAIL=your-yazio-email@example.com
YAZIO_PASSWORD=your-yazio-password

# OpenRouter (LLM gateway)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.8-flash
# reasoning effort is passed as extra_body to models that support it (e.g. google/gemini-3.8-flash)
OPENROUTER_REASONING_EFFORT=medium

# Google Health API OAuth (optional until Google Health syncing is enabled)
# In Google Cloud: enable Google Health API and create a Web application OAuth client.
# The redirect URI must exactly match: https://<your-backend>/user/google-health/callback
# (production: https://forge.kesslermatics.com/api/user/google-health/callback)
GOOGLE_HEALTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_HEALTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_HEALTH_REDIRECT_URI=https://forge.kesslermatics.com/api/user/google-health/callback
# Used for CORS and after OAuth completion. Do not include a trailing slash.
FRONTEND_URL=https://forge.kesslermatics.com
# Optional: comma-separated extra CORS origins
EXTRA_CORS_ORIGINS=

# Public MCP endpoint served by this same FastAPI service.
MCP_SERVER_URL=https://forge.kesslermatics.com/mcp
MCP_ISSUER_URL=https://forge.kesslermatics.com
# Exact Host values; localhost:* is accepted for local development.
MCP_ALLOWED_HOSTS=forge.kesslermatics.com,localhost:*,127.0.0.1:*
# Native MCP clients omit Origin. Add browser-agent origins only when needed.
MCP_ALLOWED_ORIGINS=https://forge.kesslermatics.com,http://localhost:*,http://127.0.0.1:*

# Private Forge progress-photo storage
# Must point into a persistent Docker volume (Dokploy: Advanced > Volumes, mount path /data).
# Images are stored in a non-public subdirectory of that volume.
PHOTO_STORAGE_DIR=/data/forge-progress-photos
