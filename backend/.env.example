# Backend Environment Configuration
# CRITICAL: Copy this file to .env and fill in your values
# NEVER commit the actual .env file!

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/hevycoach

# JWT Secret Key - Generate a strong random key for production!
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT Algorithm
JWT_ALGORITHM=HS256

# Token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Encryption key for API credentials (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# Yazio API Credentials (for nutrition tracking)
YAZIO_EMAIL=your-yazio-email@example.com
YAZIO_PASSWORD=your-yazio-password

# Google Health API OAuth (optional until Google Health syncing is enabled)
# In Google Cloud: enable Google Health API and create a Web application OAuth client.
# The redirect URI must exactly match: https://<your-backend>/user/google-health/callback
GOOGLE_HEALTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_HEALTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_HEALTH_REDIRECT_URI=https://your-backend.example.com/user/google-health/callback
# Used after OAuth completion. Do not include a trailing slash.
FRONTEND_URL=https://coach.kesslermatics.com

# Private Forge progress-photo storage
# Railway volume mount path confirmed for this deployment.
# Images are stored in a non-public subdirectory of the persistent volume.
PHOTO_STORAGE_DIR=/storage_path/forge-progress-photos
